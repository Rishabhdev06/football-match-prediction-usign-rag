# Football AI Predictor & RAG Assistant Configuration
# Add your API key below if you wish to enable hosted LLM reasoning:

# Google Gemini API Key (Recommended, using gemini-3.8-flash)
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# Embedding Model (Defaults to all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=chroma_db
